{
  "name": "omdbx-desktop",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dev:backend": "node scripts/dev-backend.mjs",
    "dist": "pnpm build && electron-builder --config electron-builder.config.cjs --publish never",
    "dist:mac": "pnpm build && electron-builder --config electron-builder.config.cjs --mac --publish never",
    "dist:win": "pnpm build && electron-builder --config electron-builder.config.cjs --win --publish never",
    "dist:linux": "pnpm build && electron-builder --config electron-builder.config.cjs --linux --publish never"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "lucide-solid": "^0.468.0",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15"
  },
  "description": "OMDBX desktop app (Electron + SolidJS) on the DBX dbx-web sidecar",
  "author": {
    "name": "Cenuon",
    "email": "Cenuon@users.noreply.github.com"
  },
  "homepage": "https://github.com/Cenuon/omdbx",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cenuon/omdbx.git",
    "directory": "apps/desktop-electron"
  }
}
